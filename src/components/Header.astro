---
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="nav-links">
			<a href="/">目录</a>
			<a href="/about">关于</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1.5em;
		background: #1a1a2e;
		box-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
	}
	h2 {
		margin: 0;
		font-size: 1.1em;
		font-weight: 700;
	}
	h2 a {
		text-decoration: none;
		color: #e0c080;
		letter-spacing: 0.05em;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 56px;
	}
	.nav-links {
		display: flex;
		gap: 0.5em;
	}
	.nav-links a {
		padding: 0.4em 0.8em;
		color: #ccc;
		text-decoration: none;
		border-radius: 4px;
		font-size: 0.9em;
		transition: all 0.2s;
	}
	.nav-links a:hover {
		color: #e0c080;
		background: rgba(224, 192, 128, 0.1);
	}
</style>
